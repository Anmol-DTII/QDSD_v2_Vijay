/*
 * Compile-check stand-in for the QDSD board on an nRF52840 DK.
 * Provides the aliases/labels the QDSD board definition (BOARD_ROOT) normally
 * supplies. Pin numbers are the QDSD PCBA's, per hal_gpio.c comments.
 */
/ {
	aliases {
		usb-oe = &qdsd_usb_oe;
		usb-s = &qdsd_usb_s;
		status-led-green = &qdsd_led_g;
		status-led-orange = &qdsd_led_o;
		status-led-blue = &qdsd_led_b;
		se2-en = &qdsd_se2_en;
		se05x-i2c = &i2c0;
	};

	qdsd_gpio {
		compatible = "gpio-leds";
		qdsd_usb_oe: usb_oe { gpios = <&gpio0 8 GPIO_ACTIVE_LOW>; };
		qdsd_usb_s: usb_s { gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>; };
		qdsd_led_g: led_g { gpios = <&gpio0 14 GPIO_ACTIVE_LOW>; };
		qdsd_led_o: led_o { gpios = <&gpio0 15 GPIO_ACTIVE_LOW>; };
		qdsd_led_b: led_b { gpios = <&gpio0 16 GPIO_ACTIVE_LOW>; };
		qdsd_se2_en: se2_en { gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>; };
	};
};

&spi1 { status = "disabled"; };
&i2c1 { status = "okay"; };
&i2c0 { status = "okay"; };

/delete-node/ &storage_partition;

&flash0 {
	partitions {
		qdsd_nvs_partition: partition@f8000 {
			label = "storage";
			reg = <0x000f8000 0x00008000>;
		};
	};
};
